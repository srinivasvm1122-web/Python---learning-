import tkinter as tk

def press_button(char):
    """Appends the pressed character to the input display."""
    current = display_var.get()
    display_var.set(current + str(char))

def clear_display():
    """Clears the calculation field."""
    display_var.set("")

def calculate_result():
    """Evaluates the mathematical expression safely."""
    try:
        # eval computes the string expression directly
        result = eval(display_var.get())
        display_var.set(result)
    except Exception:
        display_var.set("Error")

# Initialize the main system window
root = tk.Tk()
root.title("Calculator System")

display_var = tk.StringVar()

# Layout layout: Entry screen
screen = tk.Entry(root, textvariable=display_var, font=("Arial", 20), bd=10, insertwidth=4, width=14, borderwidth=5, justify='right')
screen.grid(row=0, column=0, columnspan=4)

# Define grid button layout
buttons = [
    ('7', 1, 0), ('8', 1, 1), ('9', 1, 2), ('/', 1, 3),
    ('4', 2, 0), ('5', 2, 1), ('6', 2, 2), ('*', 2, 3),
    ('1', 3, 0), ('2', 3, 1), ('3', 3, 2), ('-', 3, 3),
    ('C', 4, 0), ('0', 4, 1), ('=', 4, 2), ('+', 4, 3),
]

# Generate and map buttons dynamically
for text, row, col in buttons:
    if text == '=':
        action = calculate_result
    elif text == 'C':
        action = clear_display
    else:
        action = lambda x=text: press_button(x)
        
    tk.Button(root, text=text, padx=20, pady=20, font=("Arial", 14), command=action).grid(row=row, column=col)

root.mainloop()
