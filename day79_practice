books = []

while True:
    print("\n===== LIBRARY MENU =====")
    print("1. Add Book")
    print("2. Show Books")
    print("3. Search Book")
    print("4. Issue Book")
    print("5. Return Book")
    print("6. Exit")

    choice = int(input("Enter choice: "))

    if choice == 1:
        name = input("Enter book name: ")
        books.append({"name": name, "issued": False})
        print("Book added successfully!")

    elif choice == 2:
        print("\n--- BOOK LIST ---")

        if len(books) == 0:
            print("No books available.")
        else:
            for i, book in enumerate(books, 1):
                status = "Issued" if book["issued"] else "Available"
                print(i, book["name"], "-", status)

    elif choice == 3:
        name = input("Enter book name: ")
        found = False

        for book in books:
            if book["name"].lower() == name.lower():
                print("Book found!")
                print("Status:",
                      "Issued" if book["issued"] else "Available")
                found = True
                break

        if not found:
            print("Book not found.")

    elif choice == 4:
        name = input("Enter book name: ")

        for book in books:
            if book["name"].lower() == name.lower():
                if not book["issued"]:
                    book["issued"] = True
                    print("Book issued successfully!")
                else:
                    print("Book is already issued.")
                break
        else:
            print("Book not found.")

    elif choice == 5:
        name = input("Enter book name: ")

        for book in books:
            if book["name"].lower() == name.lower():
                if book["issued"]:
                    book["issued"] = False
                    print("Book returned successfully!")
                else:
                    print("Book was not issued.")
                break
        else:
            print("Book not found.")

    elif choice == 6:
        print("Thank you!")
        break

    else:
        print("Invalid choice.")