# Student Grade Calculator

def calculate_grade(mark):
    if mark >= 90:
        return "A+"
    elif mark >= 80:
        return "A"
    elif mark >= 70:
        return "B"
    elif mark >= 60:
        return "C"
    elif mark >= 50:
        return "D"
    else:
        return "Fail"


name = input("Enter student name: ")
mark = float(input("Enter marks: "))

grade = calculate_grade(mark)

print("\n----- RESULT -----")
print(f"Name  : {name}")
print(f"Marks : {mark}")
print(f"Grade : {grade}")