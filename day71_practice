import random

number = random.randint(1, 50)
attempts = 0

print("Guess the number between 1 and 50")

while True:
    guess = int(input("Enter your guess: "))
    attempts += 1

    if guess < number:
        print("Too low!")

    elif guess > number:
        print("Too high!")

    else:
        print("Correct answer!")
        print("Attempts:", attempts)
        break
