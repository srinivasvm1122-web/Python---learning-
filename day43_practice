import random


def calculator():
    print("\n--- CALCULATOR ---")

    try:
        a = float(input("First number: "))
        operator = input("Operator (+, -, *, /): ")
        b = float(input("Second number: "))

        if operator == "+":
            print("Result:", a + b)
        elif operator == "-":
            print("Result:", a - b)
        elif operator == "*":
            print("Result:", a * b)
        elif operator == "/":
            if b == 0:
                print("Cannot divide by zero.")
            else:
                print("Result:", a / b)
        else:
            print("Invalid operator.")

    except ValueError:
        print("Please enter valid numbers.")


def guessing_game():
    print("\n--- GUESSING GAME ---")

    number = random.randint(1, 100)
    attempts = 0

    while True:
        try:
            guess = int(input("Guess a number from 1 to 100: "))
            attempts += 1

            if guess < number:
                print("Too low!")
            elif guess > number:
                print("Too high!")
            else:
                print(f"Correct! Attempts: {attempts}")
                break

        except ValueError:
            print("Enter a valid number.")


def even_odd():
    print("\n--- EVEN OR ODD ---")

    try:
        number = int(input("Enter a number: "))

        if number % 2 == 0:
            print("Even number")
        else:
            print("Odd number")

    except ValueError:
        print("Enter a whole number.")


def multiplication_table():
    print("\n--- MULTIPLICATION TABLE ---")

    try:
        number = int(input("Enter a number: "))

        for i in range(1, 11):
            print(f"{number} × {i} = {number * i}")

    except ValueError:
        print("Enter a whole number.")


def main():
    while True:
        print("\n==============================")
        print("       PYTHON PRACTICE")
        print("==============================")
        print("1. Calculator")
        print("2. Guessing Game")
        print("3. Even or Odd")
        print("4. Multiplication Table")
        print("5. Exit")

        choice = input("\nChoose an option: ")

        if choice == "1":
            calculator()
        elif choice == "2":
            guessing_game()
        elif choice == "3":
            even_odd()
        elif choice == "4":
            multiplication_table()
        elif choice == "5":
            print("Thank you!")
            break
        else:
            print("Invalid choice.")


if __name__ == "__main__":
    main()