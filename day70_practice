marks = []

n = int(input("Enter number of subjects: "))

for i in range(n):
    mark = int(input("Enter marks: "))
    marks.append(mark)

print("\n--- MARKS DETAILS ---")

print("Marks:", marks)
print("Total:", sum(marks))
print("Highest:", max(marks))
print("Lowest:", min(marks))

average = sum(marks) / n

print("Average:", average)

if average >= 90:
    print("Grade: A+")
elif average >= 80:
    print("Grade: A")
elif average >= 70:
    print("Grade: B")
elif average >= 60:
    print("Grade: C")
elif average >= 35:
    print("Grade: D")
else:
    print("Fail")