print("================================")
print("       MOVIE TICKET SYSTEM")
print("================================")

age = int(input("Enter your age: "))
day = input("Enter the day (weekday/weekend): ").lower()

if age < 5:
    price = 0
    category = "Free Ticket"

elif age <= 12:
    price = 100
    category = "Child Ticket"

elif age <= 59:
    if day == "weekend":
        price = 250
        category = "Adult Weekend Ticket"
    else:
        price = 200
        category = "Adult Weekday Ticket"

else:
    price = 150
    category = "Senior Citizen Ticket"


print("\n================================")
print("          TICKET DETAILS")
print("================================")

print("Age      :", age)
print("Day      :", day)
print("Category :", category)
print("Price    : ₹", price)

if price == 0:
    print("Message  : Enjoy the movie for free! 🎉")
elif price <= 150:
    print("Message  : You got a special price! 😊")
else:
    print("Message  : Have a great movie experience! 🍿")

print("================================")
