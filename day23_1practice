# ==========================================
#       STUDENT MANAGEMENT SYSTEM
# ==========================================

students = []

while True:

    print("\n====================================")
    print("       STUDENT MANAGEMENT SYSTEM")
    print("====================================")

    print("1. Add Student")
    print("2. Display Students")
    print("3. Search Student")
    print("4. Update Student")
    print("5. Remove Student")
    print("6. Delete by Index")
    print("7. Show Total Students")
    print("8. Clear All Students")
    print("9. Exit")

    choice = int(input("\nEnter your choice: "))

    # --------------------------------------
    # 1. ADD STUDENT
    # --------------------------------------

    if choice == 1:

        name = input("Enter student name: ")

        if name in students:
            print("Student already exists!")

        else:
            students.append(name)
            print("Student added successfully!")


    # --------------------------------------
    # 2. DISPLAY STUDENTS
    # --------------------------------------

    elif choice == 2:

        print("\n--------- STUDENT LIST ---------")

        if len(students) == 0:
            print("No students available.")

        else:
            for i in range(len(students)):
                print(i, "-", students[i])


    # --------------------------------------
    # 3. SEARCH STUDENT
    # --------------------------------------

    elif choice == 3:

        name = input("Enter student name: ")

        if name in students:
            print("Student found!")
            print("Name:", name)

        else:
            print("Student not found!")


    # --------------------------------------
    # 4. UPDATE STUDENT
    # --------------------------------------

    elif choice == 4:

        if len(students) == 0:
            print("No students available.")

        else:

            for i in range(len(students)):
                print(i, "-", students[i])

            index = int(input("Enter index to update: "))

            if index >= 0 and index < len(students):

                new_name = input("Enter new name: ")

                students[index] = new_name

                print("Student updated successfully!")

            else:
                print("Invalid index!")


    # --------------------------------------
    # 5. REMOVE STUDENT BY NAME
    # --------------------------------------

    elif choice == 5:

        name = input("Enter student name to remove: ")

        if name in students:

            students.remove(name)

            print("Student removed successfully!")

        else:

            print("Student not found!")


    # --------------------------------------
    # 6. DELETE BY INDEX
    # --------------------------------------

    elif choice == 6:

        if len(students) == 0:

            print("No students available.")

        else:

            for i in range(len(students)):
                print(i, "-", students[i])

            index = int(input("Enter index to delete: "))

            if index >= 0 and index < len(students):

                deleted = students[index]

                del students[index]

                print("Deleted:", deleted)

            else:

                print("Invalid index!")


    # --------------------------------------
    # 7. TOTAL STUDENTS
    # --------------------------------------

    elif choice == 7:

        print("\nTotal Students:", len(students))


    # --------------------------------------
    # 8. CLEAR ALL
    # --------------------------------------

    elif choice == 8:

        if len(students) == 0:

            print("List is already empty.")

        else:

            students.clear()

            print("All students deleted!")


    # --------------------------------------
    # 9. EXIT
    # --------------------------------------

    elif choice == 9:

        print("\nThank you for using")
        print("Student Management System!")

        break


    # --------------------------------------
    # INVALID CHOICE
    # --------------------------------------

    else:

        print("Invalid choice!")
        print("Please enter 1 to 9.")
