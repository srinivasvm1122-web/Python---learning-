# python_practice_toolkit.py

import random
import string
import math


def calculator():
    print("\n--- Calculator ---")

    try:
        a = float(input("Enter first number: "))
        operator = input("Enter operator (+, -, *, /, %, **): ")
        b = float(input("Enter second number: "))

        if operator == "+":
            result = a + b
        elif operator == "-":
            result = a - b
        elif operator == "*":
            result = a * b
        elif operator == "/":
            if b == 0:
                print("Cannot divide by zero.")
                return
            result = a / b
        elif operator == "%":
            result = a % b
        elif operator == "**":
            result = a ** b
        else:
            print("Invalid operator.")
            return

        print("Result:", result)

    except ValueError:
        print("Please enter valid numbers.")


def number_guessing_game():
    print("\n--- Number Guessing Game ---")

    secret = random.randint(1, 100)
    attempts = 0

    print("I selected a number between 1 and 100.")

    while True:
        try:
            guess = int(input("Your guess: "))
            attempts += 1

            if guess < secret:
                print("Too low!")
            elif guess > secret:
                print("Too high!")
            else:
                print(
                    f"Correct! You found it in {attempts} attempts."
                )
                break

        except ValueError:
            print("Enter a whole number.")


def password_generator():
    print("\n--- Password Generator ---")

    try:
        length = int(input("Password length: "))

        if length < 4:
            print("Use a length of at least 4.")
            return

        characters = (
            string.ascii_letters
            + string.digits
            + string.punctuation
        )

        password = "".join(
            random.choice(characters)
            for _ in range(length)
        )

        print("Generated password:")
        print(password)

    except ValueError:
        print("Enter a valid length.")


def temperature_converter():
    print("\n--- Temperature Converter ---")
    print("1. Celsius to Fahrenheit")
    print("2. Fahrenheit to Celsius")

    choice = input("Choose: ")

    try:
        temperature = float(input("Enter temperature: "))

        if choice == "1":
            result = (temperature * 9 / 5) + 32
            print(f"{temperature}°C = {result:.2f}°F")

        elif choice == "2":
            result = (temperature - 32) * 5 / 9
            print(f"{temperature}°F = {result:.2f}°C")

        else:
            print("Invalid choice.")

    except ValueError:
        print("Enter a valid temperature.")


def prime_checker():
    print("\n--- Prime Number Checker ---")

    try:
        number = int(input("Enter a number: "))

        if number < 2:
            print("Not a prime number.")
            return

        for i in range(2, int(math.sqrt(number)) + 1):
            if number % i == 0:
                print("Not a prime number.")
                return

        print("Prime number!")

    except ValueError:
        print("Enter a whole number.")


def multiplication_table():
    print("\n--- Multiplication Table ---")

    try:
        number = int(input("Enter number: "))

        for i in range(1, 11):
            print(f"{number} × {i} = {number * i}")

    except ValueError:
        print("Enter a whole number.")


def main():
    while True:
        print("\n" + "=" * 40)
        print("       PYTHON PRACTICE TOOLKIT")
        print("=" * 40)

        print("1. Calculator")
        print("2. Number Guessing Game")
        print("3. Password Generator")
        print("4. Temperature Converter")
        print("5. Prime Number Checker")
        print("6. Multiplication Table")
        print("7. Exit")

        choice = input("\nChoose an option: ")

        if choice == "1":
            calculator()

        elif choice == "2":
            number_guessing_game()

        elif choice == "3":
            password_generator()

        elif choice == "4":
            temperature_converter()

        elif choice == "5":
            prime_checker()

        elif choice == "6":
            multiplication_table()

        elif choice == "7":
            print("Goodbye!")
            break

        else:
            print("Invalid choice.")

        input("\nPress Enter to continue...")


if __name__ == "__main__":
    main()
